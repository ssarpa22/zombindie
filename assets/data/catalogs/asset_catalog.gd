extends RefCounted

# Asset Catalog - Zombindie World Asset Library
# Generated for Godot 4.7 gl_compatibility renderer

# Format: Dictionary per entry with:
# - id: stable asset ID (unique string)
# - name: display name
# - scene_path: path to .tscn scene file (res://...)
# - category: asset category
# - subcategory: finer classification
# - footprint: size in meters (width x depth)
# - tags: array of descriptive tags
# - collision_policy: "solid", "visual_only", "trigger"
# - interaction_type: "none", "open", "close", "take", "use", etc.
# - material_family: shared material palette used

const DEFINITIONS := {}

func add_asset(id, name, scene_path, category, subcategory, footprint, tags, collision_policy, interaction_type, material_family) -> void:
	DEFINITIONS[id] := {
		"id": id,
		"name": name,
		"scene_path": scene_path,
		"category": category,
		"subcategory": subcategory,
		"footprint": footprint,
		"tags": tags,
		"collision_policy": collision_policy,
		"interaction_type": interaction_type,
		"material_family": material_family
	}

func get_asset(id) -> Dictionary:
	return DEFINITIONS.get(id, {})

func get_all_assets() -> Dictionary:
	return DEFINITIONS

func get_assets_by_category(category) -> Dictionary:
	return {k: v for k, v in DEFINITIONS.items() if v.category == category}

func get_assets_by_subcategory(category, subcategory) -> Dictionary:
	return {k: v for k, v in DEFINITIONS.items() if v.category == category and v.subcategory == subcategory}
